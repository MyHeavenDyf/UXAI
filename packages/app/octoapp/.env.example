# 复制为 .env 后按需修改。.env 不进 git，本文件进。

# 3D 预览引擎地址
# dev：3d-templete 的 vite dev server（npm run dev，端口 5173，路由 /embed）
VITE_3D_PREVIEW_URL=http://127.0.0.1:5173/embed

# 3D 预览（另开窗口）：3d-templete 运行态入口（不带 /embed）
VITE_3D_BASE=http://127.0.0.1:5173

# 3D 源码路径（3d-templete / 3d-components）不走 env，运行时 IPC 解析。
# 约定：UXAI / 3d-templete / 3d-components 三个仓库 clone 到同一父目录下（同级兄弟），
# 从 UXAI/packages/desktop 往上三层即父目录。
# 不遵循约定时设进程 env（非本文件）：OCTO_3D_TEMPLATE_SRC / OCTO_3D_COMPONENTS_SRC（绝对路径）。
